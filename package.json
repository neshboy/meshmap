{
  "name": "meshmap",
  "version": "0.1.0",
  "description": "Read-only network topology diagrams and drift detection for your docker-compose files.",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "meshmap": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "docker-compose",
    "topology",
    "homelab",
    "self-hosted",
    "diagram",
    "drift-detection"
  ],
  "dependencies": {
    "commander": "^12.1.0",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.5"
  }
}
